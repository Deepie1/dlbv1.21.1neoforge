      "advancements.deep_lucky_block.all_structures.title": "Master of Structures",
      "advancements.deep_lucky_block.all_structures.description": "Brought all 6 structures into the world.",
      "advancements.deep_lucky_block.hub_creators.title": "The Creators' Syndicate",
      "advancements.deep_lucky_block.hub_creators.description": "Meet the worst enemies of the game.",
      "advancements.deep_lucky_block.creator_1.title": "A Web Legend",
      "advancements.deep_lucky_block.creator_1.description": "Obtained your very first Creator item (e.g. Laink's sword).",
      "advancements.deep_lucky_block.creator_5.title": "Creator Collector",
      "advancements.deep_lucky_block.creator_5.description": "Obtained 5 Creator items.",
      "advancements.deep_lucky_block.creator_10.title": "Grand Master of the Web",
      "advancements.deep_lucky_block.creator_10.description": "Obtained 10 Creator items.",
      "advancements.deep_lucky_block.trio_claquette.title": "Full Team Claquette!",
      "advancements.deep_lucky_block.trio_claquette.description": "Summoned Jerry, Ben and Samouss at the same time.",
      "advancements.deep_lucky_block.hub_luck.title": "Fate",
      "advancements.deep_lucky_block.hub_luck.description": "Luck has its moods. Good or bad, fortune is lived.",
      "advancements.deep_lucky_block.lucky_chain.title": "Lucky Chain",
      "advancements.deep_lucky_block.lucky_chain.description": "Triggered 3 lucky streaks (+5 Luck). Fate likes you.",
      "advancements.deep_lucky_block.hub_grade.title": "The Zenith",
      "advancements.deep_lucky_block.hub_grade.description": "Reach the summits of absolute luck.",
      "advancements.deep_lucky_block.grade_tier_low.title": "Forge of the Common",
      "advancements.deep_lucky_block.grade_tier_low.description": "The first tiers: Used, Worn, Common, Uncommon.",
