      "enchantment.supreme_lucky_block.shadow_sprint": "Shadow Sprint",
      "enchantment.supreme_lucky_block.shadow_sprint.desc": "§7• §eShadow Sprint: §fSprint faster (stacks with other speed effects).",
      "enchantment.supreme_lucky_block.sharp_edge": "Sharp Edge",
