      "advancements.deep_lucky_block.hub_exploration.description": "Discover the hidden structures of the world.",
      "advancements.deep_lucky_block.exp_forest.title": "The Verdant Way",
      "advancements.deep_lucky_block.exp_forest.description": "Cross the forests of the Sylvan Citadel and the Fae Observatory.",
      "advancements.deep_lucky_block.structure_citadel.title": "Sylvan Citadel",
      "advancements.deep_lucky_block.structure_citadel.description": "Summon the Sylvan Citadel (+2 Deep Lucky Blocks).",
      "advancements.deep_lucky_block.structure_observatory.title": "Fae Observatory",
      "advancements.deep_lucky_block.structure_observatory.description": "Summon the Fae Observatory (+2 Deep Lucky Blocks).",
      "advancements.deep_lucky_block.exp_ruins.title": "The Broken Path",
      "advancements.deep_lucky_block.exp_ruins.description": "Uncover the ruins of the Dragon Sanctuary and the Cursed Circus.",
      "advancements.deep_lucky_block.structure_dragon.title": "Dragon Sanctuary",
      "advancements.deep_lucky_block.structure_dragon.description": "Summon the Dragon Sanctuary (+2 Deep Lucky Blocks).",
      "advancements.deep_lucky_block.structure_circus.title": "Cursed Circus",
