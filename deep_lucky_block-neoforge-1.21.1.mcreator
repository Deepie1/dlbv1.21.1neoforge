      "item.deep_lucky_block.shadow_essence": "Cristal des Ombres",
      "item.deep_lucky_block.shadow_essence.description_0": "§5§lCristal des Ombres",
      "item.deep_lucky_block.shadow_essence.description_1": "§7Un fragment sombre né des ténèbres. Combiné à une enclume avec un objet enchanté, il double le niveau de tous ses enchantements (coût : §c2§7 niveaux d'XP).",
      "item.deep_lucky_block.shadow_mirror_spawn_egg": "Œuf d'apparition de Miroir d'Ombre",
