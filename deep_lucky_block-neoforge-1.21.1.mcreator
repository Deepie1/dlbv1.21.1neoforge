      "combo.deep_lucky_block.abatteur_ouragan.desc": "Charged axe strikes unleash an electric arc (+35% damage) and restore 2 durability on the axe.",
      "combo.deep_lucky_block.abatteur_ouragan.name": "Storm-Cleaver Axe",
      "combo.deep_lucky_block.abri_tortue.desc": "Remaining crouched on the ground grants Resistance II and cuts knockback taken by 80%.",
      "combo.deep_lucky_block.abri_tortue.name": "Granite Tortoise",
      "combo.deep_lucky_block.acrobat_alchimique.desc": "Sliding along a wall and pressing Jump triggers an elastic wall-vault with zero fall damage.",
      "combo.deep_lucky_block.acrobat_alchimique.name": "Wall-Vault Acrobat",
      "combo.deep_lucky_block.acrobate_roulade.desc": "Sneaking right before landing negates 100% fall damage and rolls forward into 2s Invisibility.",
      "combo.deep_lucky_block.acrobate_roulade.name": "Tactical Drop-Roller",
      "combo.deep_lucky_block.aeronaute_supersonique_royal.desc": "While flying Elytra or Air Walking: continuous Regeneration II, -30% damage taken, and full kinetic crash immunity!",
      "combo.deep_lucky_block.aeronaute_supersonique_royal.name": "Stratosphere Sky-Sovereign",
      "combo.deep_lucky_block.ailes_orageuses_maitrisees.desc": "Turns cursed Elytra into power: slowly repairs your wings mid-flight and zaps nearby monsters!",
      "combo.deep_lucky_block.ailes_orageuses_maitrisees.name": "Storm-Tamed Wings",
      "combo.deep_lucky_block.alpiniste_stratosphere.desc": "Above Y=110, grants Speed II, Jump Boost II, and crisp mountain regeneration.",
      "combo.deep_lucky_block.alpiniste_stratosphere.name": "High-Peak Mountaineer",
      "combo.deep_lucky_block.amiral_hauturier.desc": "Catching loot grants Absorption + Dolphin's Grace and a 50% chance to double fished treasure.",
      "combo.deep_lucky_block.amiral_hauturier.name": "Leviathan High Admiral",
      "combo.deep_lucky_block.ange_plume_celeste.desc": "While descending mid-air, a sacred aura heals you, cleanses Poison and Wither, and sears undead beneath you.",
      "combo.deep_lucky_block.ange_plume_celeste.name": "Seraphim Feathergrace",
      "combo.deep_lucky_block.apiculteur_serein.desc": "Reduces damage from flying mobs (Phantoms, Vexes, Bees) by 30% and nudges them away.",
      "combo.deep_lucky_block.apiculteur_serein.name": "Peaceful Sanctuary",
      "combo.deep_lucky_block.arbalete_faucon.desc": "Hitting a target at least 2.5 blocks below you with a crossbow deals +35% damage and Slowness II.",
      "combo.deep_lucky_block.arbalete_faucon.name": "Battlement Falconer",
      "combo.deep_lucky_block.arbaletrier_dispersion.desc": "Firing a crossbow forcefully blasts back all enemies in a 5-block cone ahead of you.",
      "combo.deep_lucky_block.arbaletrier_dispersion.name": "Point-Blank Buckshot",
      "combo.deep_lucky_block.arbaletrier_eclaireur.desc": "Your bolts illuminate targets with Glowing (6s) and purge Darkness on you.",
      "combo.deep_lucky_block.arbaletrier_eclaireur.name": "Flare Lookout",
      "combo.deep_lucky_block.arbaletrier_rodeur.desc": "Loading or aiming a crossbow grants Speed II and removes movement slowdown.",
      "combo.deep_lucky_block.arbaletrier_rodeur.name": "Mobile Crossbowman",
      "combo.deep_lucky_block.archange_jugement_solaire.desc": "5-Piece Set: continuous Regeneration I in daylight, golden particle wings, and radiant beams on sweep!",
      "combo.deep_lucky_block.archange_jugement_solaire.name": "Solar Judgment Archangel (5-Piece)",
      "combo.deep_lucky_block.archer_desertique.desc": "Firing a Dry Arrow grants Strength I for 6s and +2 Absorption hearts on impact.",
      "combo.deep_lucky_block.archer_desertique.name": "Sirocco Mirage",
      "combo.deep_lucky_block.archer_distorsion_vide.desc": "Arrow impacts tear an astral rift (5 AoE magic damage) and grant you 6s of fall-damage immunity!",
      "combo.deep_lucky_block.archer_distorsion_vide.name": "Riftwalker Bowman",
      "combo.deep_lucky_block.archer_gravite.desc": "Arrow impacts pull nearby mobs inward, then detonate a soul shockwave 1s later!",
      "combo.deep_lucky_block.archer_gravite.name": "Gravity Singularity",
      "combo.deep_lucky_block.archer_oasis.desc": "Water Arrow impacts heal you and allies near the splash for 2 hearts and extinguish flames.",
      "combo.deep_lucky_block.archer_oasis.name": "Oasis Marksman",
      "combo.deep_lucky_block.archer_orage_chaine.desc": "Arrows arc lightning across up to 3 nearby targets and recharge your sprint burst.",
      "combo.deep_lucky_block.archer_orage_chaine.name": "Voltaic Chain-Archer",
      "combo.deep_lucky_block.archer_rebond.desc": "Firing an arrow right after bouncing boosts arrow velocity by +35% with kinetic sparks.",
      "combo.deep_lucky_block.archer_rebond.name": "Elastic Bankshot",
      "combo.deep_lucky_block.archer_recul.desc": "Shooting downward with your bow launches you high into the air, resets fall distance, and grants Slow Falling (3s).",
      "combo.deep_lucky_block.archer_recul.name": "Feather Recoil Vault",
      "combo.deep_lucky_block.archer_recuperateur.desc": "Hitting an enemy with a bow deals +2 piercing damage with a 35% chance to refund an arrow immediately.",
      "combo.deep_lucky_block.archer_recuperateur.name": "Flint-Shard Quiver",
      "combo.deep_lucky_block.archer_retardement.desc": "Delayed arrows mark targets and trigger a secondary sonic detonation when they go off.",
      "combo.deep_lucky_block.archer_retardement.name": "Chrono-Bomb Archer",
      "combo.deep_lucky_block.archer_ronce.desc": "Poisoned arrows leave a brief toxic puddle on impact that slows nearby foes.",
      "combo.deep_lucky_block.archer_ronce.name": "Venomous Bowman",
      "combo.deep_lucky_block.archonte_marees_celestes.desc": "Thrown Tridents fly 40% faster even in dry weather, call down lightning on impact (+40% damage), and heal 1.5 hearts!",
      "combo.deep_lucky_block.archonte_marees_celestes.name": "Celestial Tide Archon",
      "combo.deep_lucky_block.armure_eternelle_transcendante.desc": "4-Piece Royal Set: +20% all damage dealt, -15% damage taken, Wither/Slow/Levitation immunity, and golden halo.",
      "combo.deep_lucky_block.armure_eternelle_transcendante.name": "Transcendent King's Regalia",
      "combo.deep_lucky_block.artilleur_chaos_alchimique.desc": "Crossbow bolt impacts spread a 4-block alchemical mist inflicting Wither II, Weakness II, and Slowness II (5s).",
      "combo.deep_lucky_block.artilleur_chaos_alchimique.name": "Alchemical Chaos Bombardier",
      "combo.deep_lucky_block.artilleur_inquisiteur.desc": "Firing a crossbow grants Speed II, a 30% chance to refund an arrow, and a fiery brimstone blast on bolt impact.",
      "combo.deep_lucky_block.artilleur_inquisiteur.name": "Hellfalcon Volley",
      "combo.deep_lucky_block.artilleur_meteor_ecarlate.desc": "Crossbow bolts unleash a +40% blazing impact blast while granting full immunity to fire and explosion damage!",
      "combo.deep_lucky_block.artilleur_meteor_ecarlate.name": "Solar Meteor Cannoneer",
      "combo.deep_lucky_block.ascension_celeste.desc": "Mid-air with Cloud Walker: pressing Jump unlocks a 4th mid-air jump (Celestial Quadruple Jump) and a golden halo.",
      "combo.deep_lucky_block.ascension_celeste.name": "Empyrean Skywalker",
      "combo.deep_lucky_block.assassin_echange.desc": "Hitting a target with your bow blinds them (3s) and grants you Invisibility (4s) plus Strength I.",
      "combo.deep_lucky_block.assassin_echange.name": "Phantom Transposition",
      "combo.deep_lucky_block.assassin_nocturne.desc": "Striking from Invisibility teleports behind the target (2.1x damage + Darkness) and refreshes Invisibility on kill.",
      "combo.deep_lucky_block.assassin_nocturne.name": "Hidden Voidblade",
      "combo.deep_lucky_block.avatar_chimere_primordiale.desc": "5-Piece Set: unites Fire, Water, and Storm (+40% damage, fire/drowning/Riptide immunity, and healing lightning on jump)!",
      "combo.deep_lucky_block.avatar_chimere_primordiale.name": "Primordial Chimera Avatar (5-Piece)",
      "combo.deep_lucky_block.avatar_infernal.desc": "Standing on magma/lava or burning grants Regeneration II + Strength I and doubles Ember Core retaliation.",
      "combo.deep_lucky_block.avatar_infernal.name": "Ashen Hellwalker",
      "combo.deep_lucky_block.avatar_supreme_deep_lucky.desc": "ULTIMATE 6-PIECE SYNERGY: +30% all damage, -25% damage taken, continuous Luck III, Regeneration I, and White Starlight Halo!",
      "combo.deep_lucky_block.avatar_supreme_deep_lucky.name": "Ultimate Deep's Lucky Block Avatar (6-Piece Ultimate)",
      "combo.deep_lucky_block.avatar_zephyr.desc": "On Trident throw and while airborne: unleashes piercing wind gusts, +30% air mobility, and deflects 25% of incoming arrows.",
      "combo.deep_lucky_block.avatar_zephyr.name": "Lord of the Four Winds",
      "combo.deep_lucky_block.bastion_miroir.desc": "Blocking with your shield charges your weapon for 4s: +75% damage, disables shields, and stuns.",
      "combo.deep_lucky_block.bastion_miroir.name": "Guardbreaker Counter",
      "combo.deep_lucky_block.bastion_mural.desc": "When standing or sliding next to a wall, grants Regeneration I and +25% melee damage.",
      "combo.deep_lucky_block.bastion_mural.name": "Rampart Wall-Guard",
      "combo.deep_lucky_block.belier_ailes_fer.desc": "Flying through enemies with Elytra deals heavy steel-impact damage and knocks them flying safely.",
      "combo.deep_lucky_block.belier_ailes_fer.name": "Steel-Wing Battering Ram",
      "combo.deep_lucky_block.berserker_flammes.desc": "While burning, you gain Fire Resistance, +35% melee damage, and heal 0.5 heart on every hit.",
      "combo.deep_lucky_block.berserker_flammes.name": "Cinder Berserker",
      "combo.deep_lucky_block.berserker_immortel.desc": "Below 35% HP, grants Haste III while every kill immediately restores 25% of your missing health.",
      "combo.deep_lucky_block.berserker_immortel.name": "Last Breath Ransom",
      "combo.deep_lucky_block.berserker_sismique.desc": "Sprint-attacks slam the ground, launching all enemies in a cone ahead skyward!",
      "combo.deep_lucky_block.berserker_sismique.name": "Sprinting War-Hammer",
      "combo.deep_lucky_block.bourreau_decapiteur.desc": "On melee hit: instantly executes standard monsters below 18% HP and boosts trophy/loot drops.",
      "combo.deep_lucky_block.bourreau_decapiteur.name": "Royal Executioner",
      "combo.deep_lucky_block.boxeur_diamant_titan.desc": "Empty-handed: deals +9 bonus fist damage, shatters enemy guard, and grants Resistance II for 4s!",
      "combo.deep_lucky_block.boxeur_diamant_titan.name": "Adamantine Fist",
      "combo.deep_lucky_block.boxeur_rue.desc": "Bare-handed hits deal +3 bonus blunt damage and knock foes sharply back.",
      "combo.deep_lucky_block.boxeur_rue.name": "Street Brawler",
      "combo.deep_lucky_block.boxeur_sprint.desc": "Unarmed sprinting punches deal +4 bonus damage and grant 1 Absorption heart.",
      "combo.deep_lucky_block.boxeur_sprint.name": "Rushing Pugilist",
      "combo.deep_lucky_block.bretteur_balayant.desc": "Melee strikes push back nearby foes within 2.8 blocks and grant you Speed I (2s).",
      "combo.deep_lucky_block.bretteur_balayant.name": "Skirmisher",
      "combo.deep_lucky_block.brise_garde_tonnerre.desc": "After blocking with your shield, your next axe strike deals +45% bonus damage and stuns the target.",
      "combo.deep_lucky_block.brise_garde_tonnerre.name": "Shield-Splitter Huscarl",
      "combo.deep_lucky_block.brise_os_colosse.desc": "Sprinting attacks inflict Slowness IV + Weakness II (3s) in a crimson impact wave.",
      "combo.deep_lucky_block.brise_os_colosse.name": "Tendon-Shatter Blitz",
      "combo.deep_lucky_block.bucheron_infatigable.desc": "Chopping a log restores 1 hunger point and grants Speed I for 5s across woodland trails.",
      "combo.deep_lucky_block.bucheron_infatigable.name": "Tireless Woodsman",
      "combo.deep_lucky_block.bucheron_robuste.desc": "Every 6 stone blocks mined grants Resistance I (5s) and 1 Absorption heart.",
      "combo.deep_lucky_block.bucheron_robuste.name": "Quarry Mason",
      "combo.deep_lucky_block.bucheron_sylvestre.desc": "Felling logs grants Haste II, auto-replants a matching sapling, and pulls dropped wood to you.",
      "combo.deep_lucky_block.bucheron_sylvestre.name": "Ancient Forest Spirit",
      "combo.deep_lucky_block.campeur_endurci.desc": "Standing still for 3s out of combat triggers gentle Regeneration I and eases hunger.",
      "combo.deep_lucky_block.campeur_endurci.name": "Cozy Bivouac",
      "combo.deep_lucky_block.carapace_cinetique.desc": "Taking a hit clears Slowness and grants both Resistance II and Speed II for 3 seconds.",
      "combo.deep_lucky_block.carapace_cinetique.name": "Reactive Plating",
      "combo.deep_lucky_block.cavalier_royal.desc": "While mounted: +40% charge damage, Regeneration I for your mount, and hoof shockwaves.",
      "combo.deep_lucky_block.cavalier_royal.name": "Royal Mounted Lancer",
      "combo.deep_lucky_block.cavalier_tonnerre_royal.desc": "While mounted: shields your mount with Fire Resistance + Absorption, and your strikes call down lightning (+45% damage)!",
      "combo.deep_lucky_block.cavalier_tonnerre_royal.name": "Thunder Cataphract",
      "combo.deep_lucky_block.champion_maudit_transcendant.desc": "Transmutes your curses into raw power: +60% damage dealt across all dimensions and 18% lifesteal!",
      "combo.deep_lucky_block.champion_maudit_transcendant.name": "Herald of Shattered Curses",
      "combo.deep_lucky_block.chasseur_crepuscule.desc": "In dim light (<= 7), melee strikes inflict Darkness on targets and grant you Speed II for 4s.",
      "combo.deep_lucky_block.chasseur_crepuscule.name": "Dusk Stalker",
      "combo.deep_lucky_block.chasseur_opportuniste.desc": "Falling attacks deal +20% bonus damage in a shower of sparks.",
      "combo.deep_lucky_block.chasseur_opportuniste.name": "Opportunist Leap",
      "combo.deep_lucky_block.chasseur_pillards.desc": "Slaying a hostile monster restores 2 hunger points with a 25% chance to drop an Emerald.",
      "combo.deep_lucky_block.chasseur_pillards.name": "Bounty Headhunter",
      "combo.deep_lucky_block.chasseur_proie_marquee.desc": "Striking any Glowing target deals +40% bonus damage and refreshes Speed II.",
      "combo.deep_lucky_block.chasseur_proie_marquee.name": "Radiant Prey Stalker",
      "combo.deep_lucky_block.chasseur_venin.desc": "Striking a poisoned foe deals +40% acid bonus damage and refreshes their poison.",
      "combo.deep_lucky_block.chasseur_venin.name": "Farsight Viper",
      "combo.deep_lucky_block.chimere_sept_coeurs.desc": "Grants +25% all damage dealt, periodic Regeneration II, and a prismatic lightning pulse around you when jumping!",
      "combo.deep_lucky_block.chimere_sept_coeurs.name": "Prismatic Chimera Awakening",
      "combo.deep_lucky_block.choc_thermique_lame.desc": "Striking a slowed or chilled target that is also burning triggers thermal shock for +40% bonus damage.",
      "combo.deep_lucky_block.choc_thermique_lame.name": "Thermal Shock Blade",
