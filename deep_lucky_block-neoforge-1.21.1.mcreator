      "advancements.deep_lucky_block.hub_luck.title": "Le Destin",
      "advancements.deep_lucky_block.hub_luck.description": "Le hasard a ses humeurs. Bonne ou mauvaise, la chance se vit.",
      "advancements.deep_lucky_block.lucky_chain.title": "Chaîne de Chance",
      "advancements.deep_lucky_block.lucky_chain.description": "Déclenche 3 séries de chance (+5 Luck). Le destin t'aime bien.",
