      "enchantment.deep_lucky_block.rain_nourishment": "Rain Nourishment",
      "enchantment.deep_lucky_block.rain_nourishment.desc": "§7• §eRain Nourishment: §fWhile raining, heals 1 HP per level every 3 seconds.",
      "enchantment.deep_lucky_block.range_foot_placement": "Feather-Footed",
      "enchantment.deep_lucky_block.range_foot_placement.desc": "§7• §eFeather-Footed: §fWhile airborne over empty space, places Cobblestone beneath your feet.",
      "enchantment.deep_lucky_block.ranger": "Ranger",
      "enchantment.deep_lucky_block.ranger.desc": "§7• §eRanger: §fWhile aiming a bow or crossbow, grants Speed based on enchantment level.",
      "enchantment.deep_lucky_block.rapid_drop_stop": "Rapid Drop Stop",
      "enchantment.deep_lucky_block.rapid_drop_stop.desc": "§7• §eRapid Drop Stop: §fWhile sneaking in a fall, multiplies downward velocity by 1.5 for a faster descent.",
      "enchantment.deep_lucky_block.recoil_launch": "Recoil Launch",
      "enchantment.deep_lucky_block.recoil_launch.desc": "§7• §eRecoil Launch: §fEach shot pushes the shooter in the opposite direction based on level.",
      "enchantment.deep_lucky_block.recycle": "Recycle",
      "enchantment.deep_lucky_block.recycle.desc": "§7• §eRecycle: §fBreaking blocks may recover an Iron Ingot.",
      "enchantment.deep_lucky_block.red_strike_gauntlet": "Red Strike Gauntlet",
      "enchantment.deep_lucky_block.red_strike_gauntlet.desc": "§7• §eRed Strike Gauntlet: §fUnarmed hits deal +50% damage per level against unarmored enemies.",
      "enchantment.deep_lucky_block.reinforced_sharpness": "Reinforced Sharpness",
      "enchantment.deep_lucky_block.reinforced_sharpness.desc": "§7• §eReinforced Sharpness: §fAdds 2 melee damage per level.",
      "enchantment.deep_lucky_block.reinforced_sweeping": "Reinforced Sweeping",
      "enchantment.deep_lucky_block.reinforced_sweeping.desc": "§7• §eReinforced Sweeping: §fSweeping hits strike nearby enemies for 30% damage +10%/lvl.",
      "enchantment.deep_lucky_block.reliability": "Reliability",
      "enchantment.deep_lucky_block.reliability.desc": "§7• §eReliability: §fFished damageable items arrive with at least 60/90% durability.",
      "enchantment.deep_lucky_block.replanting": "Replanting",
      "enchantment.deep_lucky_block.replanting.desc": "§7• §eReplanting: §fHarvesting a mature crop automatically replants it by consuming a compatible seed.",
      "enchantment.deep_lucky_block.resistance_burst": "Resistance Burst",
      "enchantment.deep_lucky_block.resistance_burst.desc": "§7• §eResistance Burst: §fWhen hit, has a 10% chance per level to grant Resistance for 3 seconds.",
      "enchantment.deep_lucky_block.resistance_sustain": "Sustained Resistance",
      "enchantment.deep_lucky_block.resistance_sustain.desc": "§7• §eSustained Resistance: §fResistance effects on you last longer.",
      "enchantment.deep_lucky_block.resonance_curse": "Curse of Resonance",
