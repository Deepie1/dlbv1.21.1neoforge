      "enchantment.minecraft.infinity.desc": "§7• §eInfinity: §fShoots unlimited arrows as long as one arrow is in your inventory.",
      "enchantment.minecraft.knockback.desc": "§7• §eKnockback: §fKnocks the enemy back further when struck.",
      "enchantment.minecraft.looting.desc": "§7• §eLooting: §fGreatly increases loot from slain creatures.",
      "enchantment.minecraft.loyalty.desc": "§7• §eLoyalty: §fThe trident returns to your hand after being thrown.",
      "enchantment.minecraft.luck_of_the_sea.desc": "§7• §eLuck of the Sea: §fIncreases the odds of fishing rare treasures.",
      "enchantment.minecraft.lure.desc": "§7• §eLure: §fReduces the wait before a fish bites.",
      "enchantment.minecraft.mending.desc": "§7• §eMending: §fUses collected experience to repair the item.",
      "enchantment.minecraft.multishot.desc": "§7• §eMultishot: §fFires three projectiles for the cost of one.",
      "enchantment.minecraft.piercing.desc": "§7• §ePiercing: §fArrows pass through several consecutive targets.",
      "enchantment.minecraft.power.desc": "§7• §ePower: §fSignificantly increases arrow damage.",
      "enchantment.minecraft.projectile_protection.desc": "§7• §eProjectile Protection: §fReduces damage from arrows and projectiles.",
      "enchantment.minecraft.protection.desc": "§7• §eProtection: §fReduces damage taken from all combat sources.",
      "enchantment.minecraft.punch.desc": "§7• §ePunch: §fKnocks back targets hit by arrows.",
      "enchantment.minecraft.quick_charge.desc": "§7• §eQuick Charge: §fReduces crossbow draw time.",
      "enchantment.minecraft.respiration.desc": "§7• §eRespiration: §fExtends underwater breathing time.",
      "enchantment.minecraft.riptide.desc": "§7• §eRiptide: §fPropels you with the trident in water or rain.",
      "enchantment.minecraft.sharpness.desc": "§7• §eSharpness: §fIncreases melee damage against all creatures.",
      "enchantment.minecraft.silk_touch.desc": "§7• §eSilk Touch: §fLets you recover blocks intact when mining.",
      "enchantment.minecraft.smite.desc": "§7• §eSmite: §fIncreased damage against the undead.",
      "enchantment.minecraft.soul_speed.desc": "§7• §eSoul Speed: §fIncreases walking speed on soul sand.",
      "enchantment.minecraft.sweeping_edge.desc": "§7• §eSweeping Edge: §fIncreases the damage of sweeping attacks.",
      "enchantment.minecraft.swift_sneak.desc": "§7• §eSwift Sneak: §fIncreases movement speed while sneaking.",
      "enchantment.minecraft.thorns.desc": "§7• §eThorns: §fDeals damage back to melee attackers.",
      "enchantment.minecraft.unbreaking.desc": "§7• §eUnbreaking: §fThe item resists wear and tear far better.",
      "enchantment.minecraft.vanishing_curse.desc": "§7• §cCurse of Vanishing: §fThe item disappears forever when you die.",
      "enchantment.supreme_lucky_block.abyss_curse": "Curse of the Abyss",
      "enchantment.supreme_lucky_block.abyss_curse.desc": "§7• §cCurse of the Abyss: §fFishing may summon a hostile Drowned or Guardian; chance scales with level.",
      "enchantment.supreme_lucky_block.adaptive_shell": "Adaptive Shell",
      "enchantment.supreme_lucky_block.adaptive_shell.desc": "§7• §eAdaptive Shell: §fRepeated hits from the same damage type progressively reduce that damage.",
      "enchantment.supreme_lucky_block.adrenaline": "Adrenalaline",
      "enchantment.supreme_lucky_block.adrenaline.desc": "§7• §eAdrenalaline: §fGrants Speed and Resistance while your health is low.",
      "enchantment.supreme_lucky_block.advanced_sharpness": "Advanced Sharpness",
      "enchantment.supreme_lucky_block.advanced_sharpness.desc": "§7• §eAdvanced Sharpness: §f+3 damage and +8% damage per level.",
      "enchantment.supreme_lucky_block.aerodynamic": "Aerodynamic",
      "enchantment.supreme_lucky_block.aerodynamic.desc": "§7• §eAerodynamic: §fWhile gliding, reduces drag and preserves more speed per level.",
      "enchantment.supreme_lucky_block.air_brake": "Air Brake",
      "enchantment.supreme_lucky_block.air_brake.desc": "§7• §eAir Brake: §fSneaking while gliding quickly reduces horizontal and vertical speed.",
      "enchantment.supreme_lucky_block.amphibious": "Amphibious",
      "enchantment.supreme_lucky_block.amphibious.desc": "§7• §eAmphibious: §fGrants Water Breathing and Dolphin\u0027s Grace while swimming.",
      "enchantment.supreme_lucky_block.anchoring": "Anchoring",
      "enchantment.supreme_lucky_block.anchoring.desc": "§7• §eAnchoring: §fSneaking reduces horizontal speed but increases knockback resistance.",
      "enchantment.supreme_lucky_block.anglers_blessing": "Angler\u0027s Blessing",
