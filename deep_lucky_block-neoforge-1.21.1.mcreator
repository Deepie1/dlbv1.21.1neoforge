      "enchantment.deep_lucky_block.solo_combat": "Solo Combat",
      "enchantment.deep_lucky_block.solo_combat.desc": "§7• §eSolo Combat: §f+20% damage per level while no allies are nearby.",
      "enchantment.deep_lucky_block.soul_bound": "Soul Bound",
      "enchantment.deep_lucky_block.soul_bound.desc": "§7• §eSoul Bound: §fItem remains in your inventory upon death.",
      "enchantment.deep_lucky_block.soul_reaping_sickle": "Soul Reaping Sickle",
      "enchantment.deep_lucky_block.soul_reaping_sickle.desc": "§7• §eSoul Reaping Sickle: §fHoe kills may drop the victim\u0027s spawn egg (level % chance).",
      "enchantment.deep_lucky_block.soul_repulsion_blast": "Soul Repulsion Blast",
      "enchantment.deep_lucky_block.soul_repulsion_blast.desc": "§7• §eSoul Repulsion Blast: §fWhen hit, damages nearby mobs for half the incoming damage and pushes them away.",
      "enchantment.deep_lucky_block.soul_sacrifice_slash": "Soul Sacrifice Slash",
      "enchantment.deep_lucky_block.soul_sacrifice_slash.desc": "§7• §eSoul Sacrifice Slash: §fSacrifice 40% of your health to add 10% of the target\u0027s max health as bonus damage.",
      "enchantment.deep_lucky_block.sprint_impact": "Sprint Impact",
      "enchantment.deep_lucky_block.sprint_impact.desc": "§7• §eSprint Impact: §fSprint faster (stacks with other speed effects).",
      "enchantment.deep_lucky_block.sprint_punch_gauntlet": "Sprint Punch Gauntlet",
      "enchantment.deep_lucky_block.sprint_punch_gauntlet.desc": "§7• §eSprint Punch Gauntlet: §fUnarmed punches deal +1 damage per level while sprinting.",
      "enchantment.deep_lucky_block.steady_shot": "Steady Shot",
      "enchantment.deep_lucky_block.steady_shot.desc": "§7• §eSteady Shot: §fArrows fly perfectly straight without gravity. Does not slow the shooter. Max level I.",
      "enchantment.deep_lucky_block.stealth_hunter": "Stealth Hunter",
      "enchantment.deep_lucky_block.stealth_hunter.desc": "§7• §eStealth Hunter: §fAttacks from invisibility deal more damage; glowing targets take even more.",
      "enchantment.deep_lucky_block.steel_body": "Steel Body",
      "enchantment.deep_lucky_block.steel_body.desc": "§7• §eSteel Body: §fBonus health beyond 10 hearts absorbs more damage.",
      "enchantment.deep_lucky_block.sticky": "Sticky",
      "enchantment.deep_lucky_block.sticky.desc": "§7• §eSticky: §fWhenever hit, multiplies your current velocity by 0.1, nearly canceling knockback.",
      "enchantment.deep_lucky_block.stinky_feet": "Stinky Feet",
      "enchantment.deep_lucky_block.stinky_feet.desc": "§7• §eStinky Feet: §fEvery second, poisons mobs within 3 blocks for 4 seconds.",
      "enchantment.deep_lucky_block.stomach_pouch": "Stomach Pouch",
      "enchantment.deep_lucky_block.stomach_pouch.desc": "§7• §eStomach Pouch: §fReduces incoming damage by 10% per level.",
      "enchantment.deep_lucky_block.storm_strike": "Storm Strike",
      "enchantment.deep_lucky_block.storm_strike.desc": "§7• §eStorm Strike: §fCalls down lightning upon hitting target.",
      "enchantment.deep_lucky_block.strafe": "Strafe",
      "enchantment.deep_lucky_block.strafe.desc": "§7• §eStrafe: §fWhile sprinting, grants Speed based on the strongest of E-Speed, Dash, Strafe and Slide.",
      "enchantment.deep_lucky_block.straight_punch_gauntlet": "Straight Punch Gauntlet",
      "enchantment.deep_lucky_block.straight_punch_gauntlet.desc": "§7• §eStraight Punch Gauntlet: §fUnarmed punches deal +3 damage per level.",
      "enchantment.deep_lucky_block.straight_reach_gauntlet": "Straight Reach Gauntlet",
      "enchantment.deep_lucky_block.straight_reach_gauntlet.desc": "§7• §eStraight Reach Gauntlet: §fUnarmed punches deal +1 damage per level.",
      "enchantment.deep_lucky_block.string_snap": "String Snap",
      "enchantment.deep_lucky_block.string_snap.desc": "§7• §cString Snap: §fThe bowstring may snap, badly damaging the bow.",
      "enchantment.deep_lucky_block.sturdy_brute": "Sturdy Brute",
      "enchantment.deep_lucky_block.sturdy_brute.desc": "§7• §eSturdy Brute: §fBonus health beyond 10 hearts adds flat damage to your hits.",
      "enchantment.deep_lucky_block.summon_army": "Summon Army",
      "enchantment.deep_lucky_block.summon_army.desc": "§7• §eSummon Army: §fRight-click to summon allied creatures (costs XP). Kills may rally a tamed wolf.",
      "enchantment.deep_lucky_block.super_stinky_feet": "Super Stinky Feet",
      "enchantment.deep_lucky_block.super_stinky_feet.desc": "§7• §eSuper Stinky Feet: §fEvery second, applies Poison II and Slowness to mobs within 5 blocks for 4 seconds.",
      "enchantment.deep_lucky_block.suppression_shot": "Suppression Shot",
      "enchantment.deep_lucky_block.suppression_shot.desc": "§7• §eSuppression Shot: §fApplies Slowness and Weakness, with duration and strength based on level.",
      "enchantment.deep_lucky_block.supreme_sharpness": "Supreme Sharpness",
      "enchantment.deep_lucky_block.supreme_sharpness.desc": "§7• §eSupreme Sharpness: §f+8 damage and +18% damage per level. At Lvl 100, annihilates anything.",
      "enchantment.deep_lucky_block.surefooted": "Surefooted",
      "enchantment.deep_lucky_block.surefooted.desc": "§7• §eSurefooted: §fAdds knockback resistance, gradually reduces accumulated fall distance, and stacks with existing movement effects.",
      "enchantment.deep_lucky_block.swap_arrow": "Swap Arrow",
      "enchantment.deep_lucky_block.swap_arrow.desc": "§7• §eSwap Arrow: §fSwaps your position with the target hit.",
      "enchantment.deep_lucky_block.sweeping_burn_slash": "Sweeping Burn Slash",
      "enchantment.deep_lucky_block.sweeping_burn_slash.desc": "§7• §eSweeping Burn Slash: §fSweeping attacks ignite all nearby enemies.",
      "enchantment.deep_lucky_block.sweeping_enhancement": "Sweeping Enhancement",
      "enchantment.deep_lucky_block.sweeping_enhancement.desc": "§7• §eSweeping Enhancement: §fSweeping hits strike nearby enemies harder (sweeps +10% damage per level).",
      "enchantment.deep_lucky_block.sweeping_fire": "Sweeping Fire",
      "enchantment.deep_lucky_block.sweeping_fire.desc": "§7• §eSweeping Fire: §fSweeping attacks ignite all nearby enemies.",
      "enchantment.deep_lucky_block.sweeping_slash": "Sweeping Slash",
      "enchantment.deep_lucky_block.sweeping_slash.desc": "§7• §eSweeping Slash: §fSweeping hits strike nearby enemies for 30% damage +10%/lvl.",
      "enchantment.deep_lucky_block.sweeping_strike": "Sweeping Strike",
      "enchantment.deep_lucky_block.sweeping_strike.desc": "§7• §eSweeping Strike: §fSweeping hits strike nearby enemies for 30% damage +10%/lvl.",
      "enchantment.deep_lucky_block.swift_strike": "Swift Strike",
      "enchantment.deep_lucky_block.swift_strike.desc": "§7• §eSwift Strike: §f+1 damage per level on hypersonic strikes.",
      "enchantment.deep_lucky_block.swiftness": "Swiftness",
      "enchantment.deep_lucky_block.swiftness.desc": "§7• §eSwiftness: §fAdds to your sprint-speed enchantment total while sprinting.",
      "enchantment.deep_lucky_block.teleport_arrow": "Teleport Arrow",
      "enchantment.deep_lucky_block.teleport_arrow.desc": "§7• §eTeleport Arrow: §fYou teleport to where your arrow lands.",
      "enchantment.deep_lucky_block.tempered_body": "Tempered Body",
      "enchantment.deep_lucky_block.tempered_body.desc": "§7• §eTempered Body: §fEvery 5 seconds, refreshes Absorption for 5 seconds; combining these body enchantments is capped at Absorption II.",
      "enchantment.deep_lucky_block.tendon_break_gauntlet": "Tendon Break Gauntlet",
      "enchantment.deep_lucky_block.tendon_break_gauntlet.desc": "§7• §eTendon Break Gauntlet: §fUnarmed hits cripple targets with Weakness and Slowness.",
      "enchantment.deep_lucky_block.thirsty_heart": "Thirsty Heart",
      "enchantment.deep_lucky_block.thirsty_heart.desc": "§7• §6Thirsty Heart: §fYour thirst dries up nearby water sources.",
      "enchantment.deep_lucky_block.thunder_hook": "Thunder Hook",
      "enchantment.deep_lucky_block.thunder_hook.desc": "§7• §eThunder Hook: §fReeling a hooked creature has 12% lightning chance per level, doubled during thunderstorms.",
      "enchantment.deep_lucky_block.thunderstruck": "Thunderstruck",
      "enchantment.deep_lucky_block.thunderstruck.desc": "§7• §eThunderstruck: §fCalls lightning at the arrow impact point.",
      "enchantment.deep_lucky_block.tidal_step": "Tidal Step",
      "enchantment.deep_lucky_block.tidal_step.desc": "§7• §eTidal Step: §fAdds movement speed in shallow water when a solid floor is beneath you.",
      "enchantment.deep_lucky_block.tidecaller": "Tidecaller",
      "enchantment.deep_lucky_block.tidecaller.desc": "§7• §eTidecaller: §fBlock impacts create a temporary water source lasting longer per level.",
      "enchantment.deep_lucky_block.titan_slayer": "Titan Slayer",
      "enchantment.deep_lucky_block.titan_slayer.desc": "§7• §eTitan Slayer: §fMassive extra damage against giant entities, bosses, and high-HP players.",
      "enchantment.deep_lucky_block.torch": "Torch",
      "enchantment.deep_lucky_block.torch.desc": "§7• §eTorch: §fArrows plant a torch where they land.",
      "enchantment.deep_lucky_block.toy": "Toy",
      "enchantment.deep_lucky_block.toy.desc": "§7• §eToy: §fFires a rapid stream of toy arrows (~5/s) without ammo, knocking mobs back. Virtually no damage: 1 arrow in 10 stings for 1 HP.",
      "enchantment.deep_lucky_block.tracer_shot": "Tracer Shot",
      "enchantment.deep_lucky_block.tracer_shot.desc": "§7• §eTracer Shot: §fThe target glows for 0.5 seconds, then carries a bright, night-visible white halo and fading tail. Level increases halo radius, particle density, trail length and duration: 30/40/50/60/70 seconds at levels I–V.",
      "enchantment.deep_lucky_block.trailblazer": "Trailblazer",
      "enchantment.deep_lucky_block.trailblazer.desc": "§7• §eTrailblazer: §fWhile grounded on Dirt Path, Gravel, Cobblestone, Stone Bricks or Smooth Stone, grants Speed based on enchantment level.",
      "enchantment.deep_lucky_block.transfer": "Transfer",
      "enchantment.deep_lucky_block.transfer.desc": "§7• §eTransfer: §fStruck players receive your off-hand item.",
      "enchantment.deep_lucky_block.transfer_misfortune": "Transfer Misfortune",
      "enchantment.deep_lucky_block.transfer_misfortune.desc": "§7• §eTransfer Misfortune: §fMay transfer your Poison, Wither or Weakness to the struck target.",
      "enchantment.deep_lucky_block.tree_felling": "Tree Felling",
      "enchantment.deep_lucky_block.tree_felling.desc": "§7• §eTree Felling: §fFells an entire tree with a single block.",
      "enchantment.deep_lucky_block.turbulence_curse": "Curse of Turbulence",
      "enchantment.deep_lucky_block.turbulence_curse.desc": "§7• §cCurse of Turbulence: §fPeriodically adds random lateral drift while gliding, stronger in storms.",
      "enchantment.deep_lucky_block.twenty_fourth_blessing": "Twenty-Fourth Blessing",
      "enchantment.deep_lucky_block.twenty_fourth_blessing.desc": "§7• §eTwenty-Fourth Blessing: §fA blessing shields you from all fall damage.",
      "enchantment.deep_lucky_block.ultra_edge": "Ultra Edge",
      "enchantment.deep_lucky_block.ultra_edge.desc": "§7• §eUltra Edge: §f+4 damage and +10% damage per level.",
      "enchantment.deep_lucky_block.unbreakable": "Unbreakable",
      "enchantment.deep_lucky_block.unbreakable.desc": "§7• §eUnbreakable: §fItem never loses durability.",
      "enchantment.deep_lucky_block.undead_commander": "Undead Commander",
      "enchantment.deep_lucky_block.undead_commander.desc": "§7• §eUndead Commander: §fZombie and Skeleton attacks deal 50% less damage; Summon Army creates undead troops.",
      "enchantment.deep_lucky_block.undead_curse": "Undead Curse",
      "enchantment.deep_lucky_block.undead_curse.desc": "§7• §cUndead Curse: §fFalters against the undead (-60% damage) but hungers for the living (+50%).",
      "enchantment.deep_lucky_block.undertow": "Undertow",
