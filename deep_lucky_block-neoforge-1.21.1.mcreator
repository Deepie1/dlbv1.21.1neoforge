      "enchantment.deep_lucky_block.veil": "Veil",
      "enchantment.deep_lucky_block.veil.desc": "§7• §eVeil: §fAll incoming damage is halved.",
      "enchantment.deep_lucky_block.vein_miner": "Vein Miner",
      "enchantment.deep_lucky_block.vein_miner.desc": "§7• §eVein Miner: §fMine an entire ore vein at once.",
      "enchantment.deep_lucky_block.vital_reserve": "Vital Reserve",
      "enchantment.deep_lucky_block.vital_reserve.desc": "§7• §eVital Reserve: §fConverts healing above maximum health into Absorption, capped at 4 HP per level.",
      "enchantment.deep_lucky_block.wall_runner": "Wall Runner",
      "enchantment.deep_lucky_block.wall_runner.desc": "§7• §eWall Runner: §fWhile airborne against a wall, cancels fall distance, slows descent and pushes you along the wall. Level II can produce a slight climb.",
      "enchantment.deep_lucky_block.wardenspine": "Wardenspine",
      "enchantment.deep_lucky_block.wardenspine.desc": "§7• §eWardenspine: §fDamages attackers when they hit you.",
      "enchantment.deep_lucky_block.warp": "Warp",
      "enchantment.deep_lucky_block.warp.desc": "§7• §eWarp: §fRandomly teleports the struck target.",
      "enchantment.deep_lucky_block.water_arrow": "Water Arrow",
      "enchantment.deep_lucky_block.water_arrow.desc": "§7• §eWater Arrow: §fOn the first direct block impact, places water and grows grass, ferns and occasional flowers in a radius-4 sphere. Deals bonus damage to water-sensitive and End creatures.",
      "enchantment.deep_lucky_block.weak_force": "Weak Force",
